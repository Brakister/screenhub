<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenLab</AssemblyName>
    <RootNamespace>ScreenLab</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>1.5.0</Version>
    <Product>ScreenLab</Product>
    <Description>Sistema leve de captura de fotos 24/7 com usuário e carimbo de data/hora</Description>
  <!-- Embalagem: um exe unico e auto-contido, com os modelos ONNX e os
         haarcascades embutidos DENTRO do exe. Sem isso, quem baixa so o
         .exe do release nao tem a pasta Data/ ao lado e a deteccao (os
         quadradinhos) nao funciona. IncludeAllContentForSelfExtract embute
         o conteudo e o AppContext.BaseDirectory passa a apontar para a
         pasta onde ele e extraido na hora de rodar. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Modelos YuNet (detecção) e SFace (reconhecimento). Os ONNX precisam
         chegar junto do exe publicado (self-contained). -->
    <Content Include="Data\models\*.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\models\*.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
